# Copy to .env.local. Everything is optional: with nothing set, the sample runs on the
# mock data layer in /data (menu.json, shop.json, locations/*.json).

# Public site URL (used for canonical URLs, Open Graph and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.chacafeusa.com

# --- Commerce: WooCommerce Store API (existing chacafeusa.com shop) --------------------
# When set, /data/shop.json is replaced by live products from
#   {WOO_STORE_URL}/wp-json/wc/store/v1/products
# and checkout hands off to {WOO_STORE_URL}/checkout. See docs/WOOCOMMERCE.md.
WOO_STORE_URL=

# --- CMS: WordPress + ACF ---------------------------------------------------------------
# When set, menu, hours and specials load from the ACF options endpoint described in
# docs/CMS-SCHEMA.md instead of the JSON files.
WP_API_URL=

# --- Maps --------------------------------------------------------------------------------
# The sample uses MapLibre GL (open-source Mapbox GL) with a free light basemap.
# Paste a Mapbox style URL + token to switch to a custom Mapbox Studio style.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=
